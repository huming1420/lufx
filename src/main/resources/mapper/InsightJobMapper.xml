<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lufax.dashboard.repository.InsightJobMapper">

    <resultMap id="insightJobMap" type="com.lufax.dashboard.model.entity.InsightJob">
        <id property="jobId" column="job_id"/>
        <result property="period" column="period"/>
        <result property="metricVersion" column="metric_version"/>
        <result property="promptVersion" column="prompt_version"/>
        <result property="jobType" column="job_type"/>
        <result property="status" column="status"/>
        <result property="totalCount" column="total_count"/>
        <result property="finishedCount" column="finished_count"/>
        <result property="failedCount" column="failed_count"/>
        <result property="forceRefresh" column="force_refresh"/>
        <result property="createdAt" column="created_at"/>
        <result property="startedAt" column="started_at"/>
        <result property="finishedAt" column="finished_at"/>
        <result property="errorMessage" column="error_message"/>
    </resultMap>

    <sql id="allColumns">
        job_id, period, metric_version, prompt_version, job_type, status,
        total_count, finished_count, failed_count, force_refresh,
        created_at, started_at, finished_at, error_message
    </sql>

    <insert id="insert" parameterType="com.lufax.dashboard.model.entity.InsightJob">
        INSERT INTO insight_job (
            job_id, period, metric_version, prompt_version, job_type, status,
            total_count, finished_count, failed_count, force_refresh, created_at
        ) VALUES (
            #{jobId}, #{period}, #{metricVersion}, #{promptVersion}, #{jobType}, #{status},
            #{totalCount}, #{finishedCount}, #{failedCount}, #{forceRefresh}, now()
        )
    </insert>

    <update id="updateStatus">
        UPDATE insight_job
        <set>
            status = #{status},
            error_message = #{errorMessage},
            <if test="finishedCount != null">
                finished_count = #{finishedCount},
            </if>
            <if test="failedCount != null">
                failed_count = #{failedCount},
            </if>
            <if test="startedAt != null">
                started_at = #{startedAt},
            </if>
            <if test="finishedAt != null">
                finished_at = #{finishedAt},
            </if>
        </set>
        WHERE job_id = #{jobId}
    </update>

    <select id="selectById" resultMap="insightJobMap">
        SELECT <include refid="allColumns"/>
        FROM insight_job
        WHERE job_id = #{jobId}
    </select>

    <select id="selectActiveByPeriod" resultMap="insightJobMap">
        SELECT <include refid="allColumns"/>
        FROM insight_job
        WHERE period = #{period}
          AND status IN ('pending', 'running')
        ORDER BY created_at DESC
    </select>

</mapper>
