// 滚动监听 - 杜邦高亮
(function(){
  var sections=['sec-profit','sec-scale','sec-enr','sec-disburse','sec-roa','sec-pricing','sec-risk','sec-funding','sec-opex'];
  var dpMap={'sec-profit':'dp-profit','sec-scale':'dp-scale','sec-enr':'dp-scale','sec-disburse':'dp-scale','sec-roa':'dp-roa','sec-pricing':'dp-pricing','sec-risk':'dp-risk','sec-funding':'dp-funding','sec-opex':'dp-opex'};
  var navMap={'sec-profit':'[data-sec=sec-profit]','sec-scale':'[data-sec=sec-scale]','sec-enr':'[data-sec=sec-enr]','sec-disburse':'[data-sec=sec-disburse]','sec-roa':'[data-sec=sec-roa]','sec-pricing':'[data-sec=sec-pricing]','sec-risk':'[data-sec=sec-risk]','sec-funding':'[data-sec=sec-funding]','sec-opex':'[data-sec=sec-opex]'};
  window.addEventListener('scroll',function(){
    if(document.body.classList.contains('alert-view')) return;
    var current='';
    sections.forEach(function(id){
      var el=document.getElementById(id);
      if(el && el.getBoundingClientRect().top<=120) current=id;
    });
    if(!current) return;
    // 杜邦高亮
    document.querySelectorAll('.dp-box').forEach(function(b){b.classList.remove('active');});
    var dpId=dpMap[current];
    if(dpId){var d=document.getElementById(dpId);if(d)d.classList.add('active');}
    syncDupontLogic(current);
    // 侧导高亮
    document.querySelectorAll('#nav-fixed .nav-level').forEach(function(n){n.classList.remove('active');});
    var sel=navMap[current];
    if(sel){var n=document.querySelector('#nav-fixed '+sel);if(n)n.classList.add('active');}
  });
})();

function syncDupontLogic(secId){
  var bar=document.getElementById('dupont-logic-bar');
  if(!bar) return;
  bar.querySelectorAll('.dp-pill').forEach(function(node){
    node.classList.remove('active');
    var target=node.getAttribute('data-target');
    if(target===secId || (secId==='sec-enr'&&target==='sec-scale') || (secId==='sec-disburse'&&target==='sec-scale')){
      node.classList.add('active');
    }
  });
}

