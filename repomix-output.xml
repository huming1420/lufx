<file path="ai_insights.html">
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>陆金所控股 · AI 经营洞察</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
<style>
:root{
  --bg:#0f1117;--surface:#1a1d27;--surface2:#22263a;--surface3:#2a2e44;
  --border:#2e3354;--accent:#4f8ef7;--accent2:#7c5cfc;
  --green:#34d399;--red:#f87171;--yellow:#fbbf24;--orange:#fb923c;--purple:#a78bfa;
  --text:#e2e8f0;--muted:#94a3b8;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:"PingFang SC","Microsoft YaHei",sans-serif;min-height:100vh;}

/* ── 顶栏 ── */
.top-bar{background:var(--surface);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;}
.top-bar h1{font-size:16px;font-weight:700;color:var(--accent);}
.top-bar p{font-size:11px;color:var(--muted);margin-top:2px;}
.top-bar .back-btn{padding:5px 14px;border-radius:7px;font-size:11.5px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:var(--surface2);color:var(--muted);transition:.15s;}
.top-bar .back-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent);}

/* ── Tab 切换 ── */
.tab-bar{display:flex;gap:8px;padding:12px 24px;background:var(--surface);border-bottom:1px solid var(--border);}
.tab-btn{padding:7px 18px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:1px solid var(--border);background:transparent;color:var(--muted);transition:.15s;}
.tab-btn.active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-color:transparent;}
.tab-btn:hover:not(.active){background:var(--surface2);}

/* ── 内容区 ── */
.main{max-width:1200px;margin:0 auto;padding:20px 24px 60px;}
.tab-pane{display:none;}.tab-pane.active{display:block;}

/* ── Section ── */
.section{margin-bottom:24px;}
.section-header{display:flex;align-items:center;gap:10px;margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border);}
.section-title{font-size:15px;font-weight:700;}

/* ── 评分卡 ── */
.ai-score-card{background:linear-gradient(135deg,rgba(79,142,247,.08),rgba(124,92,252,.08));border:1px solid rgba(79,142,247,.3);border-radius:14px;padding:16px;display:flex;align-items:center;gap:14px;}
.ai-score-circle{width:72px;height:72px;border-radius:50%;flex-shrink:0;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;}
.ai-score-circle svg{position:absolute;top:0;left:0;}
.ai-score-num{font-size:22px;font-weight:700;line-height:1;z-index:1;}
.ai-score-label{font-size:9px;color:var(--muted);z-index:1;}
.ai-score-info h3{font-size:13px;font-weight:700;margin-bottom:4px;}
.ai-score-info p{font-size:11px;color:var(--muted);line-height:1.65;}
.ai-verdict{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:10px;font-size:10px;font-weight:700;margin-top:6px;}
.ai-verdict.warn{background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.3);color:var(--yellow);}
.ai-verdict.good{background:rgba(52,211,153,.12);border:1px solid rgba(52,211,153,.3);color:var(--green);}
.ai-verdict.poor{background:rgba(248,113,113,.12);border:1px solid rgba(248,113,113,.3);color:var(--red);}
.ai-interpret-wrap{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
@media(max-width:900px){.ai-interpret-wrap{grid-template-columns:1fr;}}

/* ── 维度卡片 ── */
.ai-dims-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
@media(max-width:768px){.ai-dims-grid{grid-template-columns:1fr 1fr;}}
.ai-dim-card{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:12px;cursor:pointer;transition:.15s;}
.ai-dim-card:hover{background:var(--surface3);border-color:var(--accent);transform:translateY(-1px);}
.ai-dim-card.active{border-color:var(--accent);box-shadow:0 0 0 2px rgba(79,142,247,.2);}
.ai-dim-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.ai-dim-name{font-size:12.5px;font-weight:700;}
.ai-dim-score-badge{font-size:10px;padding:2px 7px;border-radius:8px;font-weight:700;}
.ai-dim-bar-wrap{height:4px;background:var(--surface);border-radius:2px;overflow:hidden;margin-bottom:6px;}
.ai-dim-bar{height:100%;border-radius:2px;transition:width .5s ease;}
.ai-dim-text{font-size:10.5px;color:var(--muted);line-height:1.5;}

/* ── 深度分析框 ── */
.ai-detail-box{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:14px;margin-top:12px;}
.ai-detail-title{font-size:13px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.ai-detail-content{font-size:12px;line-height:1.75;}
.ai-detail-bullets{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
.ai-detail-bullet{display:flex;gap:8px;align-items:flex-start;}
.bul-icon{flex-shrink:0;font-size:13px;margin-top:2px;}
.bul-text{font-size:11.5px;color:var(--text);line-height:1.7;}

/* ── 根因链 ── */
.cause-chain{display:flex;flex-wrap:wrap;align-items:center;gap:0;row-gap:8px;font-size:11.5px;}
.cause-tag{padding:5px 10px;border-radius:7px;font-weight:700;}
.cause-arrow{padding:0 6px;color:var(--muted);}
.cause-sep{padding:0 8px;color:var(--border);font-size:13px;}

/* ══════════════════════════════════════════════════════════ */
/* ── 预测模块 ── */
/* ══════════════════════════════════════════════════════════ */
.ai-formula-bar{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:11px 14px;margin-bottom:16px;font-size:12px;color:var(--muted);line-height:1.7;}
.ai-scenario-btns{display:flex;gap:10px;margin-bottom:14px;}
.ai-sc-btn{flex:1;padding:10px 12px;border-radius:10px;border:2px solid transparent;background:rgba(248,113,113,.28);cursor:pointer;text-align:center;transition:.2s;font-family:inherit;color:#fff;}
.ai-sc-btn:hover{filter:brightness(1.08);}
.ai-sc-btn h4{font-size:13px;font-weight:700;margin-bottom:2px;color:#fff;}
.ai-sc-btn p{font-size:10px;color:rgba(255,255,255,.75);font-weight:400;}
/* 未选中：悲观红底 */
.ai-sc-btn.bear{background:rgba(248,113,113,.28);border-color:rgba(248,113,113,.35);}
/* 未选中：基准黄底 */
.ai-sc-btn.base{background:rgba(250,204,21,.28);border-color:rgba(250,204,21,.35);}
/* 未选中：乐观绿底 */
.ai-sc-btn.bull{background:rgba(52,211,153,.28);border-color:rgba(52,211,153,.35);}
/* 选中：加深饱和度 + 实边框 */
.ai-sc-btn.bear.active{background:rgba(248,113,113,.5);border-color:#f87171;box-shadow:0 0 12px rgba(248,113,113,.3);}
.ai-sc-btn.base.active{background:rgba(250,204,21,.5);border-color:#facc15;box-shadow:0 0 12px rgba(250,204,21,.3);}
.ai-sc-btn.bull.active{background:rgba(52,211,153,.5);border-color:#34d399;box-shadow:0 0 12px rgba(52,211,153,.3);}
.ai-pred-layout{display:grid;grid-template-columns:340px 1fr;gap:16px;}
@media(max-width:900px){.ai-pred-layout{grid-template-columns:1fr;}}
.ai-param-panel{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:16px;}
.ai-param-panel h4{font-size:13px;font-weight:700;margin-bottom:12px;}
.ai-param-group{margin-bottom:14px;}
.ai-param-group-label{font-size:10.5px;color:var(--accent);font-weight:700;margin-bottom:6px;letter-spacing:.3px;}
.ai-param-row{margin-bottom:10px;}
.ai-param-name{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:3px;}
.ai-param-val{font-weight:700;color:var(--text);font-size:11.5px;}
.ai-slider{width:100%;height:4px;-webkit-appearance:none;appearance:none;background:var(--border);border-radius:2px;outline:none;cursor:pointer;}
.ai-slider::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent);cursor:pointer;border:2px solid #fff;}
.ai-slider::-moz-range-thumb{width:14px;height:14px;border-radius:50%;background:var(--accent);cursor:pointer;border:2px solid #fff;}
.ai-result-panel{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:16px;}
.ai-result-panel h4{font-size:13px;font-weight:700;margin-bottom:12px;}
.ai-kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;}
@media(max-width:600px){.ai-kpi-row{grid-template-columns:1fr;}}
.ai-kpi-card{background:var(--surface3);border-radius:10px;padding:11px 13px;border:1px solid var(--border);}
.ai-kpi-label{font-size:10px;color:var(--muted);margin-bottom:4px;}
.ai-kpi-val{font-size:20px;font-weight:700;line-height:1;}
.ai-kpi-sub{font-size:10px;color:var(--muted);margin-top:3px;}
.ai-sensitivity-table{overflow-x:auto;}
.ai-sensitivity-table table{width:100%;border-collapse:collapse;font-size:11px;}
.ai-sensitivity-table th{padding:5px 8px;background:var(--surface3);color:var(--muted);border:1px solid var(--border);font-weight:600;text-align:center;}
.ai-sensitivity-table td{padding:4px 8px;border:1px solid var(--border);text-align:center;font-weight:600;}
.ai-narrative-box{background:linear-gradient(135deg,rgba(79,142,247,.06),rgba(124,92,252,.06));border:1px solid rgba(79,142,247,.25);border-radius:10px;padding:13px;margin-top:12px;}
.ai-narrative-box p{font-size:12px;line-height:1.85;color:var(--text);}
.ai-generate-btn{padding:5px 10px;border-radius:7px;border:1px solid rgba(79,142,247,.45);background:rgba(79,142,247,.12);color:var(--accent);font-size:10.5px;font-weight:700;cursor:pointer;font-family:inherit;transition:.15s;}
.ai-generate-btn:hover{background:rgba(79,142,247,.22);color:#fff;}
.ai-generate-btn:disabled{opacity:.55;cursor:not-allowed;}

/* ── 行业参考 ── */
.bench-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;font-size:11px;}
@media(max-width:768px){.bench-grid{grid-template-columns:repeat(2,1fr);}}
.bench-card{background:var(--surface3);border-radius:8px;padding:9px 11px;border:1px solid var(--border);}
.bench-card .label{color:var(--muted);margin-bottom:3px;font-size:10px;}
.bench-card .val{font-size:16px;font-weight:700;}
.bench-card .sub{color:var(--muted);font-size:10px;margin-top:2px;}

/* ── role 标签 ── */
.ai-dim-role{display:inline-block;font-size:9px;padding:2px 6px;border-radius:6px;font-weight:700;margin-left:6px;}
