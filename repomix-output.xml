function renderAiSankey(price, closs, fund, scost, ocost, tax, roa, anr, loanProfit, nonLoanProfit){
  var el = document.getElementById('ai-sankey-chart');
  if(!el) return;
  if(!AI_SANKEY_CHART){
    var dpr = window.devicePixelRatio || 1;
    AI_SANKEY_CHART = echarts.init(el, null, {renderer:'canvas', devicePixelRatio: dpr});
    window.addEventListener('resize',function(){try{AI_SANKEY_CHART.resize();}catch(e){}});
  }

  var revenue   = +(anr * price / 100).toFixed(1);
  var clossAmt  = +(anr * closs / 100).toFixed(1);
  var fundAmt   = +(anr * fund  / 100).toFixed(1);
  var scostAmt  = +(anr * scost / 100).toFixed(1);
  var ocostAmt  = +(anr * ocost / 100).toFixed(1);
  var bizCost   = +(scostAmt + ocostAmt).toFixed(1);
  var taxAmt    = +(anr * tax   / 100).toFixed(1);
  loanProfit = +loanProfit.toFixed(1);
  nonLoanProfit = +nonLoanProfit.toFixed(1);
  var totalProfit = +(loanProfit + nonLoanProfit).toFixed(1);

  var profitOK  = loanProfit >= 0;
  var roaColor  = roa >= 1 ? '#34d399' : roa >= 0 ? '#fbbf24' : '#f87171';
  var profColor = totalProfit >= 0 ? '#34d399' : '#f87171';
  var loanPDisp = Math.max(loanProfit, 0.5);
  var nonPDisp  = Math.abs(nonLoanProfit);

  var nANR      = 'L1 贷款规模 ANR\n' + anr + ' 亿';
  var nREV      = '定价收入\n' + revenue + ' 亿';
  var nCLOSS    = '-信贷成本\n' + clossAmt + ' 亿';
  var nFUND     = '-资金成本\n' + fundAmt + ' 亿';
  var nBIZ      = '-业务成本\n' + bizCost + ' 亿';
  var nTAX      = '-税及其他\n' + taxAmt + ' 亿';
  var nLOANP    = (profitOK ? '贷款业务净利润\n+' : '贷款业务净亏损\n') + loanProfit + ' 亿';
  var nNONLOAN  = '非贷款业务\n' + (nonLoanProfit >= 0 ? '+' : '') + nonLoanProfit + ' 亿';
  var nTOTAL    = 'L0 管理口径净利润\n' + (totalProfit >= 0 ? '+' : '') + totalProfit + ' 亿';

  var nodes = [
    {name:nANR,      itemStyle:{color:'rgba(79,142,247,.9)'},        depth:0},
    {name:nREV,      itemStyle:{color:'rgba(52,211,153,.8)'},        depth:1},
    {name:nCLOSS,    itemStyle:{color:'rgba(248,113,113,.85)'},      depth:2},
    {name:nFUND,     itemStyle:{color:'rgba(251,191,36,.8)'},        depth:2},
    {name:nBIZ,      itemStyle:{color:'rgba(251,146,60,.8)'},        depth:2},
    {name:nTAX,      itemStyle:{color:'rgba(148,163,184,.75)'},      depth:2},
    {name:nLOANP,    itemStyle:{color:roaColor},                     depth:3},
    {name:nNONLOAN,  itemStyle:{color:'rgba(100,116,139,.7)'},       depth:3},
    {name:nTOTAL,    itemStyle:{color:profColor},                    depth:4},
  ];

  var links = [
    {source:nANR, target:nREV, value:revenue, lineStyle:{color:'rgba(52,211,153,.3)'}},
    {source:nREV, target:nCLOSS, value:clossAmt, lineStyle:{color:'rgba(248,113,113,.4)'}},
    {source:nREV, target:nFUND,  value:fundAmt,  lineStyle:{color:'rgba(251,191,36,.35)'}},
    {source:nREV, target:nBIZ,   value:bizCost,  lineStyle:{color:'rgba(251,146,60,.35)'}},
    {source:nREV, target:nTAX,   value:taxAmt,   lineStyle:{color:'rgba(148,163,184,.3)'}},
    {source:nREV, target:nLOANP, value:loanPDisp, lineStyle:{color:profitOK ? 'rgba(52,211,153,.4)' : 'rgba(248,113,113,.4)'}},
    {source:nLOANP,   target:nTOTAL, value:Math.max(loanProfit, 0.5), lineStyle:{color:profitOK ? 'rgba(52,211,153,.35)' : 'rgba(248,113,113,.35)'}},
    {source:nNONLOAN, target:nTOTAL, value:nonPDisp, lineStyle:{color:'rgba(100,116,139,.25)'}},
  ];

  var opt = {
    backgroundColor:'transparent',
    tooltip:{
      trigger:'item', triggerOn:'mousemove',
      backgroundColor:'#1a1d27', borderColor:'#2e3354',
      textStyle:{color:'#e2e8f0', fontSize:11.5},
      formatter:function(p){
        if(p.dataType==='edge'){
          var src = p.data.source.split('\n')[0];
          var tgt = p.data.target.split('\n')[0];
          var pctR = revenue > 0 ? (p.value/revenue*100).toFixed(1) : '--';
          return '<b>' + src + '</b> > <b>' + tgt + '</b>'
            + '<br/>金额：<b>' + (+p.value).toFixed(1) + ' 亿</b>'
            + '<br/>占收入：<b>' + pctR + '%</b>';
        } else {
          var parts = p.name.split('\n');
          var roaPct = anr > 0 ? (p.value / anr * 100).toFixed(2) : '--';
          return '<b>' + parts[0] + '</b>' + (parts[1] ? '<br/>' + parts[1] : '')
            + '<br/>占 ANR：<b>' + roaPct + '%</b>';
