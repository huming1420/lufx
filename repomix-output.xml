function escapeHtml(value){
  return String(value == null ? '' : value)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#39;');
}

function firstValue(obj, keys, fallback){
  if(!obj) return fallback;
  for(var i=0;i<keys.length;i++){
    if(obj[keys[i]] !== undefined && obj[keys[i]] !== null && obj[keys[i]] !== '') return obj[keys[i]];
  }
  return fallback;
}

function toArray(value){
  if(value == null || value === '') return [];
  if(Array.isArray(value)) return value;
  if(typeof value === 'string') return [value];
  if(Array.isArray(value.items)) return value.items;
  if(Array.isArray(value.list)) return value.list;
  return [value];
}

function clampScore(value){
  var n = Number(value);
  if(!isFinite(n)) n = 0;
  return Math.max(0, Math.min(100, Math.round(n)));
}

function scoreMeta(score){
  if(score >= 70) return {color:'#34d399', colorBg:'rgba(52,211,153,.1)', colorBorder:'rgba(52,211,153,.3)', verdictClass:'good'};
  if(score >= 50) return {color:'#fbbf24', colorBg:'rgba(251,191,36,.12)', colorBorder:'rgba(251,191,36,.3)', verdictClass:'warn'};
  return {color:'#f87171', colorBg:'rgba(248,113,113,.12)', colorBorder:'rgba(248,113,113,.3)', verdictClass:'poor'};
}

function normalizeDimId(raw, index){
  var id = String(raw || '').trim().replace(/[^A-Za-z0-9_-]/g, '_');
  if(!id || /^_+$/.test(id)) id = 'dim_' + index;
  return id;
}

function normalizeBullet(item, fallbackIcon){
  if(typeof item === 'string') return {icon:fallbackIcon || '-', text:item};
  return {
    icon:firstValue(item, ['icon','level_icon','marker'], fallbackIcon || '-'),
    text:firstValue(item, ['text','content','point','summary','label','name'], '')
  };
}

function normalizeDimension(dim, index){
  dim = dim || {};
  var score = clampScore(firstValue(dim, ['score','health_score','value','rating'], 0));
  var meta = scoreMeta(score);
  var detail = dim.detail || dim.analysis || {};
  var bulletSource = firstValue(detail, ['bullets','points','items'], null) || firstValue(dim, ['bullets','points','findings','drivers','key_points'], []);
  var bullets = toArray(bulletSource).map(function(item){
    if(item && typeof item === 'object' && item.text !== undefined) return item;
    return normalizeBullet(item, '-');
  }).filter(function(b){ return b && b.text; });
  var name = firstValue(dim, ['name','title','dimension','label'], 'Dimension ' + (index + 1));
  var role = firstValue(dim, ['role'], '');
  var nextValidation = toArray(detail.next_validation || detail.nextValidation || []);
  return {
    id: normalizeDimId(firstValue(dim, ['id','key','dimension_id','code'], name), index),
    icon: firstValue(dim, ['icon','emoji'], '#'),
    name: name,
    score: score,
    color: firstValue(dim, ['color'], meta.color),
    colorBg: firstValue(dim, ['colorBg','color_bg','background'], meta.colorBg),
    colorBorder: firstValue(dim, ['colorBorder','color_border','border'], meta.colorBorder),
    role: role,
    brief: firstValue(dim, ['brief','summary','description','verdict','status'], ''),
    detail: {
      title: firstValue(detail, ['title','name'], name),
      content: firstValue(detail, ['content','analysis','summary','description'], firstValue(dim, ['analysis_text','detail_text','summary'], '')),
      bullets: bullets,
      next_validation: nextValidation
    }
  };
}

function renderTextBlock(value){
  if(Array.isArray(value)){
    return value.map(function(item){ return '<div>' + escapeHtml(firstValue(item, ['text','content','summary','label','name'], item)) + '</div>'; }).join('');
  }
  return escapeHtml(value || '').replace(/\n/g, '<br>');
}

function setTextById(id, value){
  var el = document.getElementById(id);
  if(el && value !== undefined && value !== null && value !== '') el.textContent = value;
}

function renderAiOverview(data){
  data = data || {};
  var scoreValue = firstValue(data, ['score','overall_score','health_score','ai_score'], null);
  if(scoreValue !== null) AI_OVERVIEW_SCORE = clampScore(scoreValue);
  updateAiScoreCircle(AI_OVERVIEW_SCORE);

  var healthLabel = firstValue(data, ['health_label','healthLabel','status_label'], null);
  var healthSummary = firstValue(data, ['health_summary','healthSummary','summary'], null);
  var verdictObj = data.verdict;
  var verdictText = null;
  var verdictClass = null;
  if(verdictObj && typeof verdictObj === 'object'){
    verdictText = verdictObj.text || verdictObj.label || null;
    verdictClass = verdictObj.level || verdictObj.class || null;
  } else {
    verdictText = firstValue(data, ['verdict_tag','verdictTag','verdict'], null);
  }
  setTextById('ai-health-label', healthLabel);
  setTextById('ai-health-summary', healthSummary);
  var verdictEl = document.getElementById('ai-verdict-tag');
  if(verdictEl && verdictText){
    var meta = scoreMeta(AI_OVERVIEW_SCORE == null ? 0 : AI_OVERVIEW_SCORE);
    verdictEl.className = 'ai-verdict ' + (verdictClass === 'good' ? 'good' : verdictClass === 'poor' ? 'poor' : verdictClass === 'warn' ? 'warn' : meta.verdictClass);
    verdictEl.textContent = verdictText;
  }
  var summaryItems = data.standard_diagnosis && data.standard_diagnosis.summary_items ? data.standard_diagnosis.summary_items : data.summary_items;
  renderSummaryItems(buildDeepSummaryItems(summaryItems, data));
}

var _dashboardPollTimer=null;

function dashboardCacheKey(){
  return AI_DASHBOARD_CACHE_PREFIX + CURRENT_PERIOD;
}

function readDashboardCache(){
  try{
    var raw = window.localStorage ? window.localStorage.getItem(dashboardCacheKey()) : null;
    if(!raw) return null;
    var cached = JSON.parse(raw);
    return cached && cached.data ? cached.data : cached;
  }catch(e){
    return null;
  }
}

function writeDashboardCache(data){
  try{
    if(!window.localStorage || !data || data.status !== 'ready') return;
    window.localStorage.setItem(dashboardCacheKey(), JSON.stringify({cached_at:Date.now(), data:data}));
  }catch(e){}
}

async function loadAiInsights(){
  if(_dashboardPollTimer){clearInterval(_dashboardPollTimer);_dashboardPollTimer=null;}
  var cachedDashboard = readDashboardCache();
  if(cachedDashboard){
    _renderDashboardData(cachedDashboard, true);
  }
  try{
    var resp = await fetch('/api/insights/dashboard?period='+encodeURIComponent(CURRENT_PERIOD));
    if(!resp.ok) throw new Error('dashboard insight request failed: ' + resp.status);
    var data = await resp.json();
    if(data.status==='running'||data.status==='pending'){
      if(cachedDashboard) return;
      var overviewEl = document.getElementById('ai-health-summary');
      if(overviewEl) overviewEl.textContent='AI动态解读生成中...';
      var verdictEl = document.getElementById('ai-verdict-tag');
      if(verdictEl){verdictEl.textContent='生成中';verdictEl.className='ai-verdict warn';}
      _dashboardPollTimer=setInterval(async function(){
        try{
          var r2=await fetch('/api/insights/dashboard?period='+encodeURIComponent(CURRENT_PERIOD));
          if(!r2.ok) return;
          var d2=await r2.json();
          if(d2.status==='ready'){
            clearInterval(_dashboardPollTimer);_dashboardPollTimer=null;
            _renderDashboardData(d2);
          } else if(d2.status==='failed'){
            clearInterval(_dashboardPollTimer);_dashboardPollTimer=null;
            var ov=document.getElementById('ai-health-summary');
            if(ov) ov.textContent=d2.error_message||'AI动态解读生成失败';
            AI_DIMS = DEFAULT_AI_DIMS.map(function(d,i){return normalizeDimension(d,i);});
            buildAiDims();
            renderCauseChain(buildCauseChainFromParams());
            renderOffsetFactors(buildOffsetFactorsFromParams());
          }
        }catch(e){console.warn('poll dashboard failed',e);}
      },3000);
      return;
    }
    if(data.status==='failed'){
      if(cachedDashboard) return;
      var ov2=document.getElementById('ai-health-summary');
      if(ov2) ov2.textContent=(data.error_message||'AI动态解读生成失败')+'，正在尝试使用规则引擎重新生成...';
      AI_DIMS = DEFAULT_AI_DIMS.map(function(d,i){return normalizeDimension(d,i);});
      buildAiDims();
      renderCauseChain(buildCauseChainFromParams());
      renderOffsetFactors(buildOffsetFactorsFromParams());
      if(!cachedDashboard) triggerDashboardInsightJob();
      return;
    }
    if(data.status==='missing'){
      if(cachedDashboard) return;
      var ov3=document.getElementById('ai-health-summary');
      if(ov3) ov3.textContent='AI动态解读尚未生成，正在自动生成...';
      AI_DIMS = DEFAULT_AI_DIMS.map(function(d,i){return normalizeDimension(d,i);});
      buildAiDims();
      renderCauseChain(buildCauseChainFromParams());
      renderOffsetFactors(buildOffsetFactorsFromParams());
      triggerDashboardInsightJob();
      return;
    }
    _renderDashboardData(data);
  } catch(err){
    console.error(err);
    if(cachedDashboard) return;
    AI_DIMS = DEFAULT_AI_DIMS.map(function(d,i){return normalizeDimension(d,i);});
    buildAiDims();
    renderCauseChain(buildCauseChainFromParams());
    renderOffsetFactors(buildOffsetFactorsFromParams());
  }
}

function triggerDashboardInsightJob(){
  fetch('/api/insights/jobs', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({period:CURRENT_PERIOD,scope:'dashboard',force_refresh:false})
  }).then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
    .then(function(data){
      if(data.job_id){
        pollDashboardJob(data.job_id);
      } else {
        setTimeout(loadAiInsights, 1000);
      }
    }).catch(function(err){
      console.warn('triggerDashboardInsightJob failed', err);
    });
}

function pollDashboardJob(jobId){
  if(_dashboardPollTimer){clearInterval(_dashboardPollTimer);_dashboardPollTimer=null;}
  _dashboardPollTimer=setInterval(async function(){
    try{
      var resp=await fetch('/api/insights/jobs/'+jobId);
      if(!resp.ok) return;
      var job=await resp.json();
      if(job.status==='finished'||job.status==='partial_failed'||job.status==='failed'){
        clearInterval(_dashboardPollTimer);_dashboardPollTimer=null;
        loadAiInsights();
      }
    }catch(e){console.warn('poll dashboard job failed',e);}
  },3000);
}

function _renderDashboardData(data, fromClientCache){
  renderAiOverview(data);
  AI_DIMS = toArray(firstValue(data, ['dimensions','ai_dimensions','dims'], [])).map(normalizeDimension);
  if(!AI_DIMS.length) AI_DIMS = DEFAULT_AI_DIMS.map(function(d,i){return normalizeDimension(d,i);});
  buildAiDims();
  renderCauseChain(firstValue(data, ['root_cause_chain','cause_chain','causeChain','ai_cause_chain'], []));
  renderOffsetFactors(firstValue(data, ['offset_factors','offsetFactors'], []));
  renderEmergingFindings(firstValue(data, ['emerging_findings','emergingFindings'], []));
  if(!fromClientCache) writeDashboardCache(data);
}

function renderCauseChain(value){
  var el = document.getElementById('ai-cause-chain');
  if(!el) return;
  var items = value && Array.isArray(value.nodes) ? value.nodes : toArray(value);
  var hasRealData = items.some(function(item){
    var label = typeof item === 'string' ? item : firstValue(item, ['label','name','text','title'], '');
    return !isPlaceholderText(label);
  });
  // 如果后端没有有效数据，且原始HTML中已存在写好的根因链节点，保留原始内容
  if((!items.length || !hasRealData) && el.querySelectorAll('.cause-tag').length > 1){
    return;
  }
  if(!items.length || !hasRealData){
    items = buildCauseChainFromParams();
  }
  if(!items.length){
    el.innerHTML = '<div class="cause-tag" style="background:rgba(148,163,184,.1);border:1px solid rgba(148,163,184,.3);color:var(--muted);">Waiting for AI cause-chain data</div>';
    return;
  }
  var html = items.map(function(item, idx){
    var label = typeof item === 'string' ? item : firstValue(item, ['label','name','text','title'], '');
    var tone = typeof item === 'string' ? '' : firstValue(item, ['tone','type','status'], '');
    var color = tone === 'good' || tone === 'positive' ? 'var(--green)' : tone === 'warn' || tone === 'warning' ? 'var(--yellow)' : tone === 'bad' || tone === 'risk' || tone === 'negative' ? 'var(--red)' : 'var(--muted)';
    var tag = '<div class="cause-tag" style="background:rgba(148,163,184,.1);border:1px solid rgba(148,163,184,.3);color:'+color+';">'+escapeHtml(label)+'</div>';
    if(idx === 0) return tag;
    return '<div class="cause-arrow">&gt;</div>' + tag;
  }).join('');
  el.innerHTML = html;
}

function renderInsightList(id, value){
  var el = document.getElementById(id);
  if(!el) return;
  var items = toArray(value);
  if(!items.length){
    el.textContent = 'No data';
    return;
  }
  el.innerHTML = items.map(function(item){
    var text = typeof item === 'string' ? item : firstValue(item, ['text','content','summary','label','name'], '');
    return '<div style="margin-bottom:4px;">' + escapeHtml(text) + '</div>';
  }).join('');
}

function renderSummaryItems(items){
  var el = document.getElementById('ai-summary-text');
  if(!el) return;
  items = toArray(items);
  if(!items.length){
    el.innerHTML = '<div style="color:var(--muted);">暂无摘要数据</div>';
    return;
  }
  var colorMap = {
    red: 'var(--red)',
    yellow: 'var(--yellow)',
    green: 'var(--green)',
    accent: 'var(--accent)',
    purple: 'var(--purple)'
  };
  el.innerHTML = items.map(function(item){
    var label = typeof item === 'string' ? '' : firstValue(item, ['label'], '');
    var color = typeof item === 'string' ? 'yellow' : firstValue(item, ['color'], 'yellow');
    var text = typeof item === 'string' ? item : firstValue(item, ['text','content'], '');
    var dotColor = colorMap[color] || colorMap.yellow;
    var labelHtml = label ? '<span class="summary-label">'+escapeHtml(label)+'：</span>' : '';
    return '<div class="summary-item">' +
      '<span class="summary-dot" style="background:'+dotColor+';"></span>' +
      '<div>'+labelHtml+'<span class="summary-text">'+escapeHtml(text)+'</span></div>' +
      '</div>';
  }).join('');
}

function stripHtmlText(value){
  var text = String(value || '');
  return text.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
}

function limitText(value, maxLen){
  var text = stripHtmlText(value);
  if(!maxLen || text.length <= maxLen) return text;
  return text.slice(0, maxLen - 1) + '…';
}

function summarizeDimensionForPanel(dim){
  if(!dim) return '';
  var detail = dim.detail || {};
  var brief = stripHtmlText(firstValue(dim, ['brief'], ''));
  var content = stripHtmlText(firstValue(detail, ['content'], ''));
  var bullets = toArray(detail.bullets).map(function(b){
    return stripHtmlText(typeof b === 'string' ? b : firstValue(b, ['text','content'], ''));
  }).filter(function(text){
    return text && text.indexOf('状态：') !== 0 && text.indexOf('当前为') === -1 && text.indexOf('规则引擎综合判断') === -1;
  });
  var validations = toArray(detail.next_validation || dim.next_validation).filter(Boolean).slice(0, 2);
  var parts = [];
  var base = content || brief;
  if(content && brief && content.indexOf(brief) >= 0) base = content;
  if(!base || base.indexOf('规则引擎评分') >= 0 || base.indexOf('规则引擎综合判断') >= 0){
    var fallbackByType = {
      scale:'规模端仍处观察区间，ANR企稳需要与新增放款质量同步验证；若增长来自高风险客群，后续风险成本可能抵消规模收益。',
      cost:'成本端是对冲项而非单独的利润修复答案；资金成本、销售成本和运营费用率若能继续下行，才有能力吸收部分风险成本压力。',
      transform:'转型进展需要看产品、渠道和客群结构是否同步改善；消金增长、直销产能和客群上移若不匹配，短期会形成利润节奏错配。',
      outlook:'综合前瞻仍偏待验证，关键不在单月指标改善，而在风险成本、规模质量和成本抵消能否连续几个周期形成同向修复。'
    };
    base = fallbackByType[dim.id] || base;
  }
  if(base) parts.push(base);
  if(bullets.length && base.indexOf('主要依据') < 0 && base.indexOf(bullets[0]) < 0) parts.push(bullets[0]);
  if(validations.length) parts.push('后续重点验证：' + validations.join('、'));
  return limitText(parts.join('；'), 110);
}

function buildDeepSummaryItems(items, data){
  data = data || {};
  var source = toArray(items).filter(function(item){
    var text = typeof item === 'string' ? item : firstValue(item, ['text','content'], '');
    return text && !isPlaceholderText(text);
  }).map(function(item){
    if(typeof item === 'string') return {type:'outlook', label:'综合判断', color:'yellow', text:item};
    return {
      type:firstValue(item, ['type'], 'outlook'),
      label:firstValue(item, ['label'], ''),
      color:firstValue(item, ['color'], 'yellow'),
      text:firstValue(item, ['text','content'], '')
    };
  });
  var dims = toArray(firstValue(data, ['dimensions','ai_dimensions','dims'], [])).map(normalizeDimension);
  var dimMap = {};
  dims.forEach(function(dim){ if(dim && dim.id) dimMap[dim.id] = dim; });
  var meta = {
    risk:{label:'风险成本', color:'red'},
    scale:{label:'规模动能', color:'yellow'},
    cost:{label:'成本效率', color:'green'},
    transform:{label:'转型进展', color:'accent'},
    profit:{label:'利润健康', color:'red'},
    outlook:{label:'综合前瞻', color:'purple'}
  };
  var seen = {};
  source = source.map(function(item){
    var dim = dimMap[item.type];
    var deeper = summarizeDimensionForPanel(dim);
    if(deeper && stripHtmlText(item.text).length < 34){
      item.text = deeper;
    } else {
      item.text = limitText(item.text, 120);
    }
    item.label = item.label || (meta[item.type] && meta[item.type].label) || '摘要';
    item.color = item.color || (meta[item.type] && meta[item.type].color) || 'yellow';
    if(item.type) seen[item.type] = true;
    return item;
  });
  ['risk','scale','cost','transform'].forEach(function(type){
    if(source.length >= 4 || seen[type] || !dimMap[type]) return;
    var text = summarizeDimensionForPanel(dimMap[type]);
    if(text){
      source.push({type:type, label:meta[type].label, color:meta[type].color, text:text});
      seen[type] = true;
    }
  });
  if(source.length < 3){
    var roots = toArray(firstValue(data, ['root_cause_chain','cause_chain','causeChain','ai_cause_chain'], []));
    roots.forEach(function(root){
      if(source.length >= 4) return;
      var text = typeof root === 'string' ? root : firstValue(root, ['label','name','text','title'], '');
      if(text && !isPlaceholderText(text)){
        source.push({type:'profit', label:'核心根因', color:'red', text:limitText('主要压力链条指向：' + text + '，需结合风险暴露节奏和利润修复进度持续验证。', 120)});
      }
    });
  }
  if(source.length < 3){
    var offsets = toArray(firstValue(data, ['offset_factors','offsetFactors'], []));
    offsets.forEach(function(offset){
      if(source.length >= 4) return;
      var factor = typeof offset === 'string' ? offset : firstValue(offset, ['factor','name','label'], '');
      var text = typeof offset === 'string' ? '' : firstValue(offset, ['text','content','description'], '');
      if(factor && !isPlaceholderText(factor)){
        source.push({type:'cost', label:'抵消因素', color:'green', text:limitText(factor + (text ? '：' + text : '') + '，但仍需验证能否持续对冲主压力。', 120)});
      }
    });
  }
  return source.slice(0, 4);
}

function renderOffsetFactors(items){
  var el = document.getElementById('ai-offset-factors');
  if(!el) return;
  items = toArray(items);
  var hasRealData = items.some(function(item){
    var factor = typeof item === 'string' ? item : firstValue(item, ['factor','name','label'], '');
    return !isPlaceholderText(factor);
  });
  // 如果后端没有有效数据，且原始HTML中已存在非占位符内容，保留原始内容
  if((!items.length || !hasRealData) && el.innerHTML && !isPlaceholderText(el.innerHTML)){
    return;
  }
  if(!items.length || !hasRealData){
    items = buildOffsetFactorsFromParams();
  }
  if(!items.length){
    el.textContent = '暂无抵消因子数据';
    return;
  }
  el.innerHTML = items.map(function(item){
    var factor = typeof item === 'string' ? item : firstValue(item, ['factor','name','label'], '');
    var text = typeof item === 'string' ? '' : firstValue(item, ['text','content','description'], '');
    var evidence = typeof item === 'string' ? [] : toArray(item.evidence);
    var html = '<div style="margin-bottom:10px;">';
    html += '<div style="font-weight:700;font-size:11.5px;color:var(--text);">'+escapeHtml(factor)+'</div>';
    if(text) html += '<div style="font-size:11px;color:var(--muted);margin-top:3px;">'+escapeHtml(text)+'</div>';
    if(evidence.length){
      html += '<div class="offset-evidence">' + evidence.map(function(e){return '<div class="offset-evidence-item">• '+escapeHtml(e)+'</div>';}).join('') + '</div>';
    }
    html += '</div>';
    return html;
  }).join('');
}

function renderEmergingFindings(items){
  var box = document.getElementById('ai-emerging-box');
  var el = document.getElementById('ai-emerging-findings');
  if(!box || !el) return;
  items = toArray(items);
  if(!items.length){
    box.style.display = 'none';
    return;
  }
  box.style.display = 'block';
  var typeLabels = {
    contradiction: '矛盾信号',
    hidden_risk: '隐藏风险',
    quality_issue: '质量问题',
    offset_failure: '抵消失效',
    structural_shift: '结构迁移',
    second_order_effect: '二阶影响'
  };
  el.innerHTML = items.map(function(item){
    var type = item.type || 'unknown';
    var finding = item.finding || '';
    var confidence = item.confidence || '';
    var supporting = toArray(item.supporting_facts);
    var why = item.why_it_matters || '';
    var next = toArray(item.next_validation);
    var confColor = confidence === 'high' ? 'var(--red)' : confidence === 'medium' ? 'var(--yellow)' : 'var(--muted)';
    var html = '<div class="emerging-item">';
    html += '<span class="emerging-type '+type+'">'+(typeLabels[type] || type)+'</span>';
    html += '<div class="emerging-finding">'+escapeHtml(finding)+'</div>';
    html += '<div class="emerging-meta">';
    if(confidence) html += '<div>置信度：<span style="color:'+confColor+';">'+escapeHtml(confidence)+'</span></div>';
    if(supporting.length) html += '<div>支撑事实：'+supporting.map(function(s){return escapeHtml(s);}).join('；')+'</div>';
    if(why) html += '<div>重要性：<strong>'+escapeHtml(why)+'</strong></div>';
    if(next.length) html += '<div>后续验证：'+next.map(function(n){return escapeHtml(n);}).join('；')+'</div>';
    html += '</div></div>';
    return html;
  }).join('');
}

function buildAiDims(){
  var grid = document.getElementById('ai-dims-grid');
  if(!grid) return;
  grid.innerHTML = '';

  // 如果后端返回维度不足6个，用默认数据补齐，并保持固定顺序
  if(AI_DIMS.length < 6){
    var existingMap = {};
    AI_DIMS.forEach(function(d){existingMap[d.id]=d;});
    AI_DIMS = DEFAULT_AI_DIMS.map(function(def, idx){
      return existingMap[def.id] || normalizeDimension(def, idx);
    });
  }

  if(!AI_DIMS.length){
    grid.innerHTML = '<div style="grid-column:1/-1;background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:12px;color:var(--muted);font-size:11.5px;">Waiting for AI dimension data.</div>';
  updateAiScoreCircle(AI_OVERVIEW_SCORE);
  return;
  }
  AI_DIMS.forEach(function(d){
    var meta = scoreMeta(d.score);
    var pct = d.score + '%';
    var html = '<div class="ai-dim-card" data-dim-id="'+escapeHtml(d.id)+'" id="aidim-'+escapeHtml(d.id)+'">' +
      '<div class="ai-dim-top">' +
        '<span class="ai-dim-name">'+escapeHtml(d.icon)+' '+escapeHtml(d.name)+'</span>' +
        '<span class="ai-dim-score-badge" style="background:'+escapeHtml(d.colorBg || meta.colorBg)+';color:'+meta.color+';border:1px solid '+escapeHtml(d.colorBorder || meta.colorBorder)+'">'+d.score+'</span>' +
      '</div>' +
      '<div class="ai-dim-bar-wrap"><div class="ai-dim-bar" style="width:'+pct+';background:'+meta.color+'"></div></div>' +
      '<div class="ai-dim-text">'+escapeHtml(d.brief)+'</div>' +
    '</div>';
    grid.insertAdjacentHTML('beforeend', html);
  });
  grid.querySelectorAll('.ai-dim-card').forEach(function(card){
    card.addEventListener('click', function(){ showAiDetail(card.getAttribute('data-dim-id')); });
  });
  updateAiScoreCircle(AI_OVERVIEW_SCORE);
  setTimeout(function(){ showAiDetail((AI_DIMS.find(function(d){return d.id==='outlook';}) || AI_DIMS[0]).id); }, 100);
}

function updateAiScoreCircle(scoreOverride){
  var avg = scoreOverride;
  if(avg === undefined || avg === null){
    avg = AI_DIMS.length ? Math.round(AI_DIMS.reduce(function(s,d){return s+d.score;},0) / AI_DIMS.length) : 0;
  }
  avg = clampScore(avg);
  var numEl = document.getElementById('ai-score-num');
  var arcEl = document.getElementById('ai-score-arc');
  if(numEl) numEl.textContent = avg;
  var full = 188.5;
  var filled = full * avg / 100;
  var offset = full - filled;
  if(arcEl) arcEl.setAttribute('stroke-dashoffset', offset.toFixed(1));
  var meta = scoreMeta(avg);
  if(numEl) numEl.style.color = meta.color;
}

function showAiDetail(dimId){
  var dim = AI_DIMS.find(function(d){return d.id===dimId;});
  if(!dim) return;
  document.querySelectorAll('.ai-dim-card').forEach(function(c){c.classList.remove('active');});
  var cardEl = document.getElementById('aidim-'+dimId);
  if(cardEl) cardEl.classList.add('active');
  var iconEl = document.getElementById('ai-detail-icon');
  var nameEl = document.getElementById('ai-detail-dim-name');
  var roleEl = document.getElementById('ai-detail-role');
  var contentEl = document.getElementById('ai-detail-content');
  var nextValEl = document.getElementById('ai-detail-next-validation');
  if(iconEl) iconEl.textContent = dim.icon;
  if(nameEl) nameEl.textContent = dim.detail.title || dim.name;
  if(roleEl){
    roleEl.innerHTML = '';
  }
  var bullets = toArray(dim.detail.bullets).map(function(b){
    var icon = b.icon || '-';
    var text = b.text || '';
    var safeText = text.replace(/<strong>/g, '<strong>').replace(/<\/strong>/g, '</strong>');
    safeText = safeText.replace(/<script/gi, '&lt;script').replace(/<style/gi, '&lt;style').replace(/<div/gi, '&lt;div').replace(/<span/gi, '&lt;span').replace(/<table/gi, '&lt;table').replace(/<br>/gi, '');
    return '<div class="ai-detail-bullet"><span class="bul-icon">'+escapeHtml(icon)+'</span><span class="bul-text">'+safeText+'</span></div>';
  }).join('');
  if(contentEl) contentEl.innerHTML =
    '<p style="margin-bottom:8px;color:var(--muted);font-size:11.5px;">'+escapeHtml(dim.detail.content || dim.brief || '')+'</p>' +
    '<div class="ai-detail-bullets">'+bullets+'</div>';
  if(nextValEl){
    var validations = toArray(dim.detail.next_validation);
    if(validations.length){
      nextValEl.innerHTML = '<div class="next-val-box"><div class="next-val-title">🔎 后续验证指标</div>' +
        validations.map(function(v){return '<div class="next-val-item">• '+escapeHtml(v)+'</div>';}).join('') +
        '</div>';
    } else {
      nextValEl.innerHTML = '';
    }
  }
}

