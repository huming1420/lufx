function colorHeatmap(tableEl,minVal,maxVal){
  if(!tableEl) return;
  tableEl.querySelectorAll('td:not(.rh):not(.na)').forEach(function(td){
    var v=parseFloat(td.textContent);
    if(isNaN(v)){td.classList.add('na');return;}
    var ratio=(v-minVal)/(maxVal-minVal||1);
    ratio=Math.max(0,Math.min(1,ratio));
    var r=Math.round(248*ratio+52*(1-ratio));
    var g=Math.round(113*ratio+211*(1-ratio));
    var b=Math.round(113*ratio+153*(1-ratio));
    td.style.background='rgba('+r+','+g+','+b+',0.25)';
    td.style.color='rgb('+r+','+g+','+b+')';
  });
}

