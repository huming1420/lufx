.ytag{font-size:10px;padding:2px 8px;border-radius:10px;font-weight:600;}
.ytag.up{background:rgba(248,113,113,.15);color:var(--red);}
.ytag.dn{background:rgba(52,211,153,.12);color:var(--green);}
.ytag.flat{background:rgba(148,163,184,.1);color:var(--muted);}
.collapse-btn{font-size:11px;padding:3px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--muted);cursor:pointer;display:inline-flex;align-items:center;gap:4px;margin-top:6px;}
.collapse-btn:hover{background:var(--surface3);}
.collapse-content{overflow:hidden;transition:max-height .35s ease;max-height:0;}
.collapse-content.open{max-height:800px;}
.data-table{width:100%;border-collapse:collapse;font-size:11px;margin-top:8px;}
.data-table th{padding:5px 9px;background:var(--surface3);color:var(--muted);font-weight:600;text-align:right;border:1px solid var(--border);}
.data-table th:first-child{text-align:left;}
.data-table td{padding:4px 9px;border:1px solid var(--border);text-align:right;color:var(--text);}
.data-table td:first-child{text-align:left;color:var(--muted);}
.data-table tr:hover td{background:var(--surface2);}
.td-pos{color:var(--red);}
.td-neg{color:var(--green);}
.heatmap-wrap{overflow-x:auto;margin-top:8px;border-radius:8px;border:1px solid var(--border);}
.heatmap-table{border-collapse:collapse;font-size:11px;min-width:100%;}
.heatmap-table th{padding:5px 8px;background:var(--surface3);color:var(--muted);font-size:10.5px;border:1px solid var(--border);font-weight:600;white-space:nowrap;position:sticky;top:0;}
.heatmap-table td{padding:4px 7px;border:1px solid var(--border);text-align:center;font-weight:600;font-size:10.5px;transition:.2s;min-width:52px;}
.heatmap-table td.na{color:var(--muted);font-weight:400;background:var(--surface);}
.heatmap-table td.rh{text-align:left;color:var(--muted);background:var(--surface3);font-weight:700;white-space:nowrap;}
.view-fixed{display:block;}
.view-alert{display:none;}
body.alert-view .view-fixed{display:none;}
body.alert-view .view-alert{display:block;}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:.2s;}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:20px;max-width:420px;width:92%;position:relative;}
.modal h3{font-size:13.5px;margin-bottom:10px;color:var(--accent);}
.modal p{font-size:12px;line-height:1.75;color:var(--muted);}
.modal-close{position:absolute;top:11px;right:13px;background:none;border:none;color:var(--muted);font-size:18px;cursor:pointer;}
.inline-row{display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap;}
.inline-row>.chart-card{flex:1;min-width:240px;}
.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:10px 12px;}
.kpi-label{font-size:10.5px;color:var(--muted);line-height:1.3;}
.kpi-val{font-size:20px;font-weight:800;margin-top:4px;}
.kpi-sub{font-size:10px;color:var(--muted);margin-top:2px;}
.kpi-ytd{font-size:9px;color:var(--accent);margin-top:2px;}
