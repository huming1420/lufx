var LAMP_COLORS=['red','yellow','green'];
function cycleLamp(dotEl,key,type){
  var cur=LAMP_COLORS.find(function(c){return dotEl.classList.contains(c);})||'green';
  var next=LAMP_COLORS[(LAMP_COLORS.indexOf(cur)+1)%3];
  LAMP_COLORS.forEach(function(c){dotEl.classList.remove(c);});
  dotEl.classList.add(next);
}

