var M24=[]; for(var i=0;i<24;i++){var d=new Date(2024,0+i,1);M24.push(d.getFullYear()+'/'+(d.getMonth()+1)+'月');}
var M16=[]; for(var i=0;i<16;i++){var d=new Date(2024,0+i,1);M16.push(d.getFullYear()+'/'+(d.getMonth()+1)+'月');}
var M15_25=[]; for(var i=0;i<15;i++){var d=new Date(2025,0+i,1);M15_25.push(d.getFullYear()+'/'+(d.getMonth()+1)+'月');}

function trend(start,end,n,noise){
  var arr=[],step=(end-start)/(n-1);
  for(var i=0;i<n;i++){
    var r=start+step*i+(Math.random()-0.5)*noise*2;
    arr.push(+r.toFixed(2));
  }
  return arr;
}
function randArr(base,n,noise){
  var a=[];for(var i=0;i<n;i++)a.push(+(base+(Math.random()-0.5)*noise*2).toFixed(2));return a;
}

function normalizeInsightList(items){
  if(!items) return [];
  return Array.isArray(items)?items:[items];
}
function insightItemText(item){
  if(item==null) return '';
  if(typeof item==='string') return item;
  if(typeof item==='number' || typeof item==='boolean') return String(item);
  return item.label || item.title || item.name || item.text || item.driver || item.item || JSON.stringify(item);
}
function appendInsightTags(root,title,items,bg,color){
  var list=normalizeInsightList(items).map(insightItemText).filter(Boolean);
  if(!list.length) return;
  var wrap=document.createElement('div');
  wrap.style.cssText='display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;';
  var label=document.createElement('span');
  label.textContent=title;
  label.style.cssText='font-size:11px;color:var(--muted);margin-right:2px;';
  wrap.appendChild(label);
  list.forEach(function(text){
    var tag=document.createElement('span');
    tag.textContent=text;
    tag.style.cssText='display:inline-flex;align-items:center;padding:2px 7px;border-radius:999px;background:'+bg+';color:'+color+';font-size:11px;line-height:1.5;';
    wrap.appendChild(tag);
  });
  root.appendChild(wrap);
}
function appendInsightEvidence(root,evidence){
  var list=normalizeInsightList(evidence).map(insightItemText).filter(Boolean);
  if(!list.length) return;
  var details=document.createElement('details');
  details.style.cssText='margin-top:8px;color:var(--muted);font-size:11px;';
  var summary=document.createElement('summary');
  summary.textContent='查看依据';
  summary.style.cursor='pointer';
  details.appendChild(summary);
  list.forEach(function(text){
    var item=document.createElement('div');
    item.textContent=text;
    item.style.cssText='margin-top:5px;padding-left:10px;border-left:2px solid var(--border);';
    details.appendChild(item);
  });
  root.appendChild(details);
}
function renderCardInsight(el,data){
  el.innerHTML='';
  var body=document.createElement('div');
  body.textContent=(data && data.insight) ? data.insight : '正在生成洞察...';
  el.appendChild(body);
  if(!data) return;
  appendInsightTags(el,'驱动',data.drivers,'rgba(79,142,247,.16)','var(--accent)');
  appendInsightTags(el,'关注',data.watch_items,'rgba(251,191,36,.16)','var(--yellow)');
  appendInsightEvidence(el,data.evidence);
}

var _insightPollTimers=[];
function _clearInsightPollTimers(){
  _insightPollTimers.forEach(function(t){clearInterval(t);});
  _insightPollTimers=[];
}

function loadInsightPageState(period){
  _clearInsightPollTimers();
  fetch('/api/insights/page-state?period='+encodeURIComponent(period))
    .then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
    .then(function(state){
      var cards=state.cards||[];
      cards.forEach(function(c){
        var el=document.querySelector('.insight-text[data-card-id="'+c.card_id+'"]');
        if(!el) return;
        if(c.status==='ready'){
          renderCardInsightFromCache(el,c);
        } else if(c.status==='running'||c.status==='pending'){
          el.textContent='洞察生成中...';
          el.style.cursor='default';
          el.onclick=null;
        } else if(c.status==='failed'){
          el.textContent=c.standard_insight||'洞察生成失败，请点击刷新重试';
          el.style.cursor='pointer';
          el.onclick=function(){ el.style.cursor=''; el.onclick=null; refreshOneCardInsight(c.card_id); };
        } else {
          el.textContent='洞察尚未生成';
          el.style.cursor='pointer';
          el.onclick=function(){ el.style.cursor=''; el.onclick=null; refreshOneCardInsight(c.card_id); };
        }
      });
      updateInsightProgressBar(state);
      var activeJobs=state.active_jobs||[];
      if(activeJobs.length>0){
        activeJobs.forEach(function(job){
          pollJobStatus(job.job_id,period);
        });
      } else if(cards.some(function(c){return c.status==='missing';})){
        triggerMissingInsights(period);
      } else {
        var bar2=document.getElementById('ai-insight-progress');
        if(bar2) bar2.style.display='none';
      }
    })
    .catch(function(err){
      console.warn('loadInsightPageState failed',err);
      var els=Array.from(document.querySelectorAll('.insight-text[data-card-id]'));
      els.forEach(function(el){ el.textContent='洞察加载失败'; });
    });
}

function triggerMissingInsights(period){
  fetch('/api/insights/jobs',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({period:period,scope:'all',force_refresh:false})
  }).then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
    .then(function(data){
      if(data.job_id){
        pollJobStatus(data.job_id,period);
      }
    }).catch(function(err){ console.warn('triggerMissingInsights failed',err); });
}

function renderCardInsightFromCache(el,c){
  el.innerHTML='';
  var body=document.createElement('div');
  body.textContent=c.standard_insight||'';
  el.appendChild(body);
  appendInsightTags(el,'驱动',c.drivers,'rgba(79,142,247,.16)','var(--accent)');
  appendInsightTags(el,'关注',c.watch_items,'rgba(251,191,36,.16)','var(--yellow)');
  appendInsightEvidence(el,c.evidence);
  var btn=document.createElement('span');
  btn.textContent='🔄刷新';
  btn.title='刷新此卡片AI洞察';
  btn.style.cssText='cursor:pointer;font-size:10px;color:var(--muted);margin-left:6px;user-select:none;';
  btn.onclick=function(e){e.stopPropagation();refreshOneCardInsight(c.card_id);};
  el.appendChild(btn);
}

function pollJobStatus(jobId,period){
  var timer=setInterval(function(){
    fetch('/api/insights/jobs/'+jobId)
      .then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
      .then(function(job){
        updateInsightProgressBar(job);
        if(job.status==='finished'||job.status==='partial_failed'||job.status==='failed'){
          clearInterval(timer);
          loadInsightPageState(period);
          return;
        }
        (job.items||[]).forEach(function(it){
          if(it.status==='ready'){
            var el=document.querySelector('.insight-text[data-card-id="'+it.card_id+'"]');
            if(el && el.textContent.indexOf('生成中')>=0){
              el.textContent='已生成，加载中...';
            }
          }
        });
      })
      .catch(function(err){
        console.warn('pollJobStatus failed',jobId,err);
      });
  },3000);
  _insightPollTimers.push(timer);
}

function updateInsightProgressBar(stateOrJob){
  var bar=document.getElementById('ai-insight-progress');
  if(!bar) return;
  var total,finished,failed,status;
  if(stateOrJob.active_jobs){
    var jobs=stateOrJob.active_jobs;
    if(!jobs.length){bar.style.display='none';return;}
    total=0;finished=0;failed=0;status='running';
    jobs.forEach(function(j){total+=j.total_count||0;finished+=j.finished_count||0;failed+=j.failed_count||0;});
  } else {
    total=stateOrJob.total_count||0;
    finished=stateOrJob.finished_count||0;
    failed=stateOrJob.failed_count||0;
    status=stateOrJob.status||'';
  }
  if(!total || status==='finished' || status==='partial_failed' || status==='failed'){
    bar.style.display='none';
    return;
  }
  bar.style.display='flex';
  var pct=total>0?Math.round((finished+failed)/total*100):0;
  bar.innerHTML='<span style="font-size:11px;color:var(--accent);">AI洞察生成进度：'+(finished)+'/'+total+' 完成'+(failed?'，'+failed+' 失败':'')+' ('+pct+'%)</span>' +
    '<div style="flex:1;height:6px;background:var(--surface);border-radius:3px;overflow:hidden;margin:0 10px;"><div style="width:'+pct+'%;height:100%;background:var(--accent);border-radius:3px;transition:width .3s;"></div></div>';
}

function refreshAllInsights(){
  fetch('/api/insights/jobs',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({period:CURRENT_PERIOD,scope:'all',force_refresh:true})
  }).then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
    .then(function(data){
      if(data.job_id){
        var els=Array.from(document.querySelectorAll('.insight-text[data-card-id]'));
        els.forEach(function(el){ el.textContent='洞察生成中...'; el.style.cursor='default'; el.onclick=null; });
        pollJobStatus(data.job_id,CURRENT_PERIOD);
      }
    }).catch(function(err){ console.warn('refreshAllInsights failed',err); });
}

function refreshOneCardInsight(cardId){
  var el=document.querySelector('.insight-text[data-card-id="'+cardId+'"]');
  if(el){ el.textContent='洞察生成中...'; el.style.cursor='default'; el.onclick=null; }
  fetch('/api/insights/jobs',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify({period:CURRENT_PERIOD,scope:'card',card_ids:[cardId],force_refresh:true})
  }).then(function(resp){ if(!resp.ok) throw new Error('HTTP '+resp.status); return resp.json(); })
    .then(function(data){
      if(data.job_id) pollJobStatus(data.job_id,CURRENT_PERIOD);
      else if(el) loadInsightPageState(CURRENT_PERIOD);
