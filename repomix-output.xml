.formula-row:last-child{margin-bottom:0;}
.f-tag{color:var(--yellow);font-weight:700;}
.f-eq{color:var(--accent);font-weight:700;}
.f-op{color:var(--muted);}
.f-chip{background:var(--surface);border:1px solid var(--border);border-radius:6px;padding:2px 8px;font-size:10.5px;color:var(--text);font-weight:600;}
.f-res{font-size:12px;font-weight:800;color:var(--green);}
