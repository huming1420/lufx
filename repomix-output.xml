function switchView(v){
  var isAlert=(v==='alert');
  document.body.classList.toggle('alert-view',isAlert);
  document.getElementById('btn-fixed').classList.toggle('active',!isAlert);
  document.getElementById('btn-alert').classList.toggle('active',isAlert);
  // 导航
  document.getElementById('nav-fixed').style.display=isAlert?'none':'block';
  document.getElementById('nav-alert').style.display=isAlert?'block':'none';
  // 杜邦
  document.getElementById('dupont-bar').style.display=isAlert?'none':'';
  document.getElementById('dupont-bar-alert').style.display=isAlert?'':'none';
  // 内容区
  document.querySelectorAll('.view-fixed').forEach(function(el){el.style.display=isAlert?'none':'block';});
  document.querySelectorAll('.view-alert').forEach(function(el){el.style.display=isAlert?'block':'none';});
