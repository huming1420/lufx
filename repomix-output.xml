      }
    },
    series:[{
      type:'sankey',
      left:'2%', right:'16%', top:'6%', bottom:'6%',
      nodeWidth:20, nodeGap:12, layoutIterations:64, nodeAlign:'left',
      emphasis:{focus:'adjacency'},
      label:{fontSize:10, color:'#e2e8f0', fontWeight:600, formatter:function(p){var parts=p.name.split('\n');return parts[0]+(parts[1]?'\n'+parts[1]:'');}},
      lineStyle:{curveness:0.5, opacity:0.45},
      data: nodes, links: links,
    }]
  };
  AI_SANKEY_CHART.setOption(opt, true);
}

// ══════════════════════════════════════════════════════════
// 敏感性矩阵
// ══════════════════════════════════════════════════════════
function renderSensTable(price, closs, fund, scost, ocost, tax, anr){
  var container = document.getElementById('ai-sens-table');
  if(!container) return;
  var priceDeltas = [-1.5, -0.5, 0, +0.5, +1.5];
  var clossDeltas = [+2, +1, 0, -1, -2];
  var html = '<table style="width:100%;border-collapse:collapse;font-size:11px;">';
  html += '<thead><tr>';
  html += '<th style="padding:5px 8px;background:var(--surface3);color:var(--muted);border:1px solid var(--border);text-align:left;min-width:90px;">ROA % /损失 >定价</th>';
  priceDeltas.forEach(function(pd){
    var lbl = pd===0?'基准':(pd>0?'+':'')+pd+'pct';
    html += '<th style="padding:5px 8px;background:var(--surface3);color:var(--muted);border:1px solid var(--border);">'+lbl+'</th>';
  });
  html += '</tr></thead><tbody>';
  clossDeltas.forEach(function(cd){
    var rowLbl = cd===0?'基准':(cd>0?'+':'')+cd+'pct';
    html += '<tr><td style="padding:5px 8px;background:var(--surface3);color:var(--muted);border:1px solid var(--border);font-weight:600;">'+rowLbl+'</td>';
    priceDeltas.forEach(function(pd){
      var r = (price+pd) - (closs+cd) - fund - scost - ocost - tax;
      var prof = (r * anr / 100).toFixed(0);
      var isBase = (pd===0 && cd===0);
      var bgColor = r>=1?'rgba(52,211,153,.2)':r>=0?'rgba(251,191,36,.15)':'rgba(248,113,113,.18)';
      var textColor = r>=1?'#34d399':r>=0?'#fbbf24':'#f87171';
      var border = isBase ? '2px solid var(--accent)' : '1px solid var(--border)';
      html += '<td style="padding:5px 8px;border:'+border+';background:'+bgColor+';color:'+textColor+';font-weight:600;text-align:center;">';
      html += r.toFixed(2)+'%<br><span style="font-size:9.5px;opacity:.8;">'+(r>=0?'+':'')+prof+'亿</span></td>';
    });
    html += '</tr>';
  });
  html += '</tbody></table>';
  container.innerHTML = html;
}

// ══════════════════════════════════════════════════════════
// AI 叙述
// ══════════════════════════════════════════════════════════
function renderScenarioPlaceholder(result){
  var el = document.getElementById('ai-narrative-text');
  if(!el) return;
  result = result || LAST_PREDICT_RESULT || {};
  var p = result.params || {};
  var profitColor = result.net_profit >= 0 ? 'var(--green)' : 'var(--red)';
  var roaColor = result.roa >= 1 ? 'var(--green)' : result.roa >= 0 ? 'var(--yellow)' : 'var(--red)';
  el.innerHTML = '当前参数组合尚未读取到AI预测解读缓存。<br><br>' +
    '测算结果：ANR '+(p.anr || '--')+'亿元、综合定价率 '+(p.price || '--')+'%、信贷损失率 '+(p.closs || '--')+'%，ROA为 <strong style="color:'+roaColor+'">'+(result.roa !== undefined ? result.roa.toFixed(2) : '--')+'%</strong>，净利润为 <strong style="color:'+profitColor+'">'+(result.net_profit >= 0 ? '+' : '')+(result.net_profit !== undefined ? result.net_profit.toFixed(1) : '--')+'亿元</strong>。<br><br>' +
    '<span style="color:var(--muted);font-size:10.5px;">这只是规则测算结果，不是AI解读。点击“生成AI情景解读”后会写入缓存，刷新页面会自动读取真实AI内容。</span>';
}

function scenarioSignature(result){
  result = result || {};
  return JSON.stringify({
    period: CURRENT_PERIOD,
    scenario: result.scenario,
    inputs: result.params,
    computed: {
      total_cost_rate: result.total_cost_rate,
      roa: result.roa,
      net_profit: result.net_profit,
      revenue: result.revenue,
      margin: result.margin
    },
    sensitivity: result.impact
  });
}

function buildScenarioPayload(result, cacheOnly){
  result = result || LAST_PREDICT_RESULT;
  return {
    period: CURRENT_PERIOD,
    language: 'zh-CN',
    cache_only: !!cacheOnly,
    scenario: result.scenario,
    scenario_label: result.scenario_label,
    inputs: {
      anr: result.params.anr,
      consumer_finance_growth: result.params.cg,
      pricing_rate: result.params.price,
      credit_loss_rate: result.params.closs,
      npl_rate: result.params.npl,
      funding_cost_rate: result.params.fund,
      sales_cost_rate: result.params.scost,
      opex_rate: result.params.ocost,
      tax_other_rate: result.params.tax,
      non_loan_profit: result.non_loan_profit
    },
    computed: {
      total_cost_rate: result.total_cost_rate,
      roa: result.roa,
      net_profit: result.net_profit,
      revenue: result.revenue,
      margin: result.margin
    },
    sensitivity: {
      credit_loss_0_5pct_impact: result.impact.credit_loss_0_5pct,
      pricing_0_5pct_impact: result.impact.pricing_0_5pct
    }
  };
}

function scheduleScenarioCacheLookup(){
  if(!LAST_PREDICT_RESULT) return;
  var sig = scenarioSignature(LAST_PREDICT_RESULT);
  LAST_SCENARIO_SIGNATURE = sig;
  if(sig !== LAST_RENDERED_AI_SIGNATURE){
    var el = document.getElementById('ai-narrative-text');
    if(el) el.textContent = '正在查询AI预测解读缓存...';
  }
  if(SCENARIO_CACHE_TIMER) clearTimeout(SCENARIO_CACHE_TIMER);
  SCENARIO_CACHE_TIMER = setTimeout(function(){
    loadScenarioInsightCache(sig);
  }, 250);
}

async function loadScenarioInsightCache(signature){
  if(!LAST_PREDICT_RESULT || signature !== LAST_SCENARIO_SIGNATURE) return;
  try{
    var resp = await fetch('/api/insights/scenario', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(buildScenarioPayload(LAST_PREDICT_RESULT, true))
    });
    if(!resp.ok) throw new Error('scenario cache request failed: ' + resp.status);
    var json = await resp.json();
    var data = json && json.data ? json.data : json;
    if(signature !== LAST_SCENARIO_SIGNATURE) return;
    if(data && data.status === 'ready'){
      renderScenarioInsight(data, signature);
    } else {
      renderScenarioPlaceholder(LAST_PREDICT_RESULT);
    }
  }catch(err){
    console.warn('loadScenarioInsightCache failed', err);
    if(signature === LAST_SCENARIO_SIGNATURE) renderScenarioPlaceholder(LAST_PREDICT_RESULT);
  }
}

async function generateScenarioInsight(){
  updatePredict();
  var result = LAST_PREDICT_RESULT;
  var btn = document.getElementById('ai-generate-scenario-btn');
  var narrativeEl = document.getElementById('ai-narrative-text');
  var oldText = btn ? btn.textContent : '';
  if(btn){ btn.disabled = true; btn.textContent = '生成中...'; }
  if(narrativeEl) narrativeEl.textContent = '正在读取缓存；如未命中将生成AI情景解读...';
  try{
    var signature = scenarioSignature(result);
    var resp = await fetch('/api/insights/scenario', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(buildScenarioPayload(result, false))
    });
    if(!resp.ok) throw new Error('scenario insight request failed: ' + resp.status);
    var json = await resp.json();
    var data = json && json.data ? json.data : json;
    renderScenarioInsight(data, signature);
  } catch(err){
    console.error(err);
    if(narrativeEl) narrativeEl.textContent = 'AI情景解读生成失败，请确认后端服务可用后重试。';
  } finally {
    if(btn){ btn.disabled = false; btn.textContent = oldText; }
  }
}

function renderScenarioInsight(data, signature){
  var el = document.getElementById('ai-narrative-text');
  if(!el) return;
  if(signature) LAST_RENDERED_AI_SIGNATURE = signature;
  data = data || {};
  var explanation = data.standard_explanation || data.explanation || data;
  var fields = [
    ['scenario_label','情景'],
    ['judgement','判断'],
    ['profit_driver','利润驱动'],
    ['key_variable','关键变量'],
    ['risk_boundary','风险边界'],
    ['upside_condition','上行条件'],
    ['sensitivity_comment','敏感性'],
    ['management_commentary','管理层关注']
  ];
  var html = fields.map(function(pair){
    var value = pair[0] === 'scenario_label' ? data[pair[0]] : explanation[pair[0]];
    if(value === undefined || value === null || value === '') return '';
    return '<div style="margin-bottom:7px;"><strong style="color:var(--accent);">'+pair[1]+': </strong>'+renderTextBlock(value)+'</div>';
  }).join('');
  var exploration = data.scenario_exploration || data.exploration || {};
  var explorationFields = [
    ['fragile_assumption','脆弱假设'],
    ['hidden_risk','隐藏风险'],
    ['upside_surprise','上行惊喜']
  ];
  explorationFields.forEach(function(pair){
    var item = exploration[pair[0]];
    if(!item) return;
    html += '<div style="margin-top:8px;"><strong style="color:var(--purple);">'+pair[1]+': </strong>'+renderTextBlock(item.insight || item)+'</div>';
    var facts = toArray(item.supporting_facts || item.facts);
    if(facts.length){
      html += '<div style="color:var(--muted);font-size:10.5px;margin-top:3px;">依据：' + facts.map(function(f){return escapeHtml(f);}).join(' / ') + '</div>';
    }
  });
  var watchItems = toArray(data.watch_items || data.watchItems);
  if(watchItems.length){
    html += '<div style="margin-top:8px;"><strong style="color:var(--yellow);">后续关注： </strong>' + watchItems.map(function(item){
      var text = typeof item === 'string' ? item : firstValue(item, ['text','content','summary','label','name'], '');
      return '<div style="margin-top:4px;">- ' + escapeHtml(text) + '</div>';
    }).join('') + '</div>';
  }
  el.innerHTML = html || '未返回AI情景解读。';
}
// ══════════════════════════════════════════════════════════
// 初始化
// ══════════════════════════════════════════════════════════
function applyHashTab(){
  var h=(location.hash||'').replace(/^#/,'');
  if(h==='predict' || h==='interpret'){
    switchTab(h, null);
  }
}
window.addEventListener('DOMContentLoaded', function(){
  applyHashTab();
  loadAiInsights();
  // 延迟初始化确保容器尺寸稳定后高清渲染
  setTimeout(function(){ updatePredict(); }, 200);
});
window.addEventListener('hashchange', applyHashTab);
</script>
</body>
</html>
