function getSliderVal(id){
  var sl = document.getElementById('sl-'+id);
  return sl ? parseFloat(sl.value) : 0;
}

function isPlaceholderText(text){
  if(!text) return true;
  var t = String(text).trim().toLowerCase();
  var placeholders = ['未识别','暂无','无数据','waiting','no data','未检测到','不存在','无效','not identified','none'];
  return placeholders.some(function(p){ return t.indexOf(p) !== -1; });
}

function buildCauseChainFromParams(){
  var price = getSliderVal('price');
  var closs = getSliderVal('closs');
  var fund = getSliderVal('fund');
  var scost = getSliderVal('scost');
  var ocost = getSliderVal('ocost');
  var tax = getSliderVal('tax');
  var roa = price - closs - fund - scost - ocost - tax;
  var chain = [];
  if(roa < 0){
    chain.push({label:'净利润亏损（ROA ' + roa.toFixed(2) + '%）', tone:'negative'});
    chain.push({label:'信贷损失率 ' + closs.toFixed(1) + '% 侵蚀利润', tone:'negative'});
    if(closs > price * 0.4) chain.push({label:'风险成本超过定价利差的40%', tone:'warning'});
    chain.push({label:'资金+运营+销售+税合计 ' + (fund+scost+ocost+tax).toFixed(2) + '%', tone:'negative'});
  } else {
    chain.push({label:'净利润盈利（ROA ' + roa.toFixed(2) + '%）', tone:'positive'});
    chain.push({label:'信贷损失率可控 ' + closs.toFixed(1) + '%', tone:'good'});
  }
  return chain;
}

function buildOffsetFactorsFromParams(){
  var factors = [];
  var cg = getSliderVal('cg');
  var fund = getSliderVal('fund');
  var ocost = getSliderVal('ocost');
  var price = getSliderVal('price');
  var closs = getSliderVal('closs');
  if(cg > 15){
    factors.push({factor:'消金规模高增长', text:'消费金融增速 ' + cg.toFixed(0) + '%，部分对冲传统业务规模压降的影响。', evidence:['消金增速+' + cg.toFixed(0) + '%']});
  }
  if(fund < 2.5){
    factors.push({factor:'综合资金成本优势', text:'综合资金成本 ' + fund.toFixed(2) + '%，处于行业较低水平。', evidence:['资金成本' + fund.toFixed(2) + '%']});
  }
  if(ocost < 1.5){
    factors.push({factor:'运营成本优化', text:'运营成本率 ' + ocost.toFixed(1) + '%，成本端呈现改善趋势。', evidence:['运营成本率' + ocost.toFixed(1) + '%']});
  }
  if(price > 17 && closs < 7){
    factors.push({factor:'定价覆盖风险', text:'综合定价率 ' + price.toFixed(1) + '% 高于信贷损失率 ' + closs.toFixed(1) + '%，利差空间健康。', evidence:['定价率' + price.toFixed(1) + '%','损失率' + closs.toFixed(1) + '%']});
  }
  if(factors.length === 0){
    factors.push({factor:'当前参数下正向抵消不显著', text:'基于当前杜邦参数，未检测到显著的正向抵消效应。', evidence:[]});
  }
  return factors;
}

function updatePredict(){
  var anr = getSliderVal('anr');
  var cg = getSliderVal('cg');
  var price = getSliderVal('price');
  var closs = getSliderVal('closs');
  var npl = getSliderVal('npl');
  var fund = getSliderVal('fund');
  var scost = getSliderVal('scost');
  var ocost = getSliderVal('ocost');
  var tax = getSliderVal('tax');

  var vals = {anr:anr,cg:cg,price:price,closs:closs,npl:npl,fund:fund,scost:scost,ocost:ocost,tax:tax};
  Object.keys(vals).forEach(function(k){
    var el = document.getElementById('pv-'+k);
    if(el) el.textContent = vals[k];
  });

  var totalCost = closs + fund + scost + ocost + tax;
  var roa = price - totalCost;
  var roaAdj = roa * 0.01;
  var nonLoanProfit = -5;
  var loanProfit = anr * roaAdj;
  var netProfit = loanProfit + nonLoanProfit;
  var revenue = anr * price * 0.01;
  var margin = revenue > 0 ? (netProfit / revenue * 100) : 0;
  var impact = {
    credit_loss_0_5pct: +(anr * 0.005).toFixed(2),
    pricing_0_5pct: +(anr * 0.005).toFixed(2),
    roa_1pct: +(anr * 0.01).toFixed(2)
  };
  LAST_PREDICT_RESULT = {
    scenario: CURRENT_SCENARIO,
    scenario_label: SCENARIOS[CURRENT_SCENARIO] ? SCENARIOS[CURRENT_SCENARIO].label : CURRENT_SCENARIO,
    params: vals,
    total_cost_rate: +totalCost.toFixed(2),
    roa: +roa.toFixed(2),
    loan_profit: +loanProfit.toFixed(2),
    non_loan_profit: nonLoanProfit,
    net_profit: +netProfit.toFixed(2),
    revenue: +revenue.toFixed(2),
    margin: +margin.toFixed(2),
    impact: impact
  };

  var roaEl = document.getElementById('pred-roa');
  var profEl = document.getElementById('pred-profit');
  var margEl = document.getElementById('pred-margin');
  var vsEl = document.getElementById('pred-profit-vs');

  if(roaEl){roaEl.textContent = roa.toFixed(2) + '%';roaEl.style.color = roa >= 1 ? 'var(--green)' : roa >= 0 ? 'var(--yellow)' : 'var(--red)';}
  if(profEl){profEl.textContent = (netProfit>=0?'+':'') + netProfit.toFixed(1) + ' 亿';profEl.style.color = netProfit >= 0 ? 'var(--green)' : 'var(--red)';}
  if(margEl){margEl.textContent = margin.toFixed(1) + '%';margEl.style.color = margin >= 5 ? 'var(--green)' : margin >= 0 ? 'var(--yellow)' : 'var(--red)';}
  if(vsEl){var diff = netProfit - (-17);vsEl.textContent = '较2025实际 -17亿：' + (diff>=0?'+':'') + diff.toFixed(1) + ' 亿';vsEl.style.color = diff>=0 ? 'var(--green)' : 'var(--red)';}

  renderAiSankey(price, closs, fund, scost, ocost, tax, roa, anr, loanProfit, nonLoanProfit);
  renderSensTable(price, closs, fund, scost, ocost, tax, anr);
  scheduleScenarioCacheLookup();
}
