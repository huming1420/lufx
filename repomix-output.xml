};
var _charts={};
function initLazy(id,opt){
  _charts[id]={opt:opt,done:false};
}
function flushLazy(){
  Object.keys(_charts).forEach(function(id){
    var rec=_charts[id];
    if(rec.done) return;
    var el=document.getElementById(id);
    if(!el){return;}
    var w=el.offsetWidth||el.parentElement.offsetWidth||0;
    var h=el.offsetHeight||el.parentElement.offsetHeight||0;
    if(w===0&&h===0){return;}
    try{
      var chart=echarts.init(el);
      chart.setOption(rec.opt);
      (function(c){window.addEventListener('resize',function(){try{c.resize();}catch(e){}});})(chart);
      rec.done=true; rec.inst=chart;
    }catch(e){console.warn('[Chart Init Error]',id,e.message);}
  });
}
// Re-flush after switching views
function flushView(){setTimeout(flushLazy,120);}


